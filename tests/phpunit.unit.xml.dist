<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    bootstrap="bootstrap-unit.php"
    colors="true"
    beStrictAboutTestsThatDoNotTestAnything="true"
>
    <testsuites>
        <testsuite name="unit">
            <directory suffix="Test.php">./unit</directory>
        </testsuite>
    </testsuites>
</phpunit>
