# ==========================================
# Generic WordPress Plugin .gitignore
# ==========================================

# Composer
/vendor/

# Node / frontend
/node_modules/
/dist/
/build/

# IDE / OS
.vscode/
.idea/
*.log
.DS_Store
Thumbs.db

# Local planning bundle — never committed to this repo
/.claude/
/specs/

# PHPUnit local override only — the committed configs are tests/*.dist
/phpunit.xml
/tests/.wp-core

# Misc cache
*.cache
